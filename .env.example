# Puerto HTTP del servidor
PORT=3000

# Carpeta donde se guardan la base de datos (SQLite) y los archivos subidos.
# En producción debe estar en un disco/volumen persistente.
DATA_DIR=./data

# URL pública de la app (se usa en los enlaces de Teams y notificaciones)
PUBLIC_URL=https://asistencia.tuescuela.org

# Contraseña del panel de plataforma (#/platform) para crear y administrar escuelas.
# Si se deja vacía, el panel de plataforma queda deshabilitado.
PLATFORM_ADMIN_PASSWORD=

# Notificaciones push (opcional). Si no se definen, se generan automáticamente
# y se guardan en la base de datos. VAPID_SUBJECT debe ser un correo real.
VAPID_SUBJECT=mailto:soporte@tuescuela.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Tamaño máximo de cada archivo de excusa (MB)
MAX_UPLOAD_MB=10
